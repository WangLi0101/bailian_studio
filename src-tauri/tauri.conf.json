{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bailian Studio",
  "version": "0.1.0",
  "identifier": "com.wangli.bailianstudio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "百炼创作工坊 · Bailian Studio",
        "width": 1380,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "阿里云百炼 AI 图片与视频创作工作台",
    "longDescription": "接入阿里云百炼（DashScope）文生图、文生视频与图生视频能力，在桌面端完成创作、预览与作品管理。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}